PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# Supabase PostgreSQL connection. For the Session pooler use the host and project-qualified user from Supabase Connect.
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.project-ref
DB_PASSWORD=replace-with-your-supabase-password
DB_NAME=postgres
DB_SSL=true
# DATABASE_URL=postgresql://postgres:encoded-password@db.example.supabase.co:5432/postgres?sslmode=require
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=Admin12345$
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@fkams.local
ADMIN_PHONE=
OTP_ROLES=admin,dos,parent,teacher,accountant,librarian
OTP_CHANNEL=email
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Use console only for local development. Configure a real provider before production.
OTP_PROVIDER=console
# Optional admission notifications. Email uses SMTP above; SMS uses Twilio when all values are set.
# For Gmail SMTP, set SMTP_USER to your Gmail address and SMTP_PASSWORD to a 16-character Google App Password.
# Do not use your regular Gmail password. If Gmail returns 534 / "WebLoginRequired", the app password is missing or invalid.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_ENABLED=false
WHATSAPP_DELAY_MS=3000
WHATSAPP_DEFAULT_COUNTRY_CODE=250
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com
PUBLIC_LOGO_URL=http://localhost:5173/forever.jpg
